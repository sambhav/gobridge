{
  "version": "1.0.0",
  "python": {"distribution": "gobridge-multi-example"},
  "typescript": {"package": "gobridge-multi-example"},
  "modules": [
    {
      "name": "catalog",
      "source": "../catalog",
      "command": "../catalog/cmd/catalog",
      "python": {"module": "acme.catalog"},
      "typescript": {"export": "./catalog"}
